# ---- Secrets & credentials (never commit) ----
.env
*.env
grocery_tracker.json
*service-account*.json
*credentials*.json

# ---- Python ----
venv/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# ---- Data files ----
# Root-level working CSVs (today's scrape before it's moved to stores/) stay local.
/*.csv
# The DuckDB warehouse is rebuilt locally from stores/ via warehouse/load.py.
*.duckdb
*.duckdb.wal
# Large translation-memory cache is regenerated by the pipeline; keep it out of git.
product_translation_memory.csv

# NOTE: dated scrape CSVs in stores/ ARE committed (by the daily CI job) — they are
# the version-controlled raw data the warehouse is built from. So stores/ is NOT ignored.
!stores/

# ---- ML / experiment tracking ----
mlruns/
*.pkl
*.joblib

# ---- dbt build artifacts ----
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/package-lock.yml

# ---- App / tooling ----
.streamlit/secrets.toml
.DS_Store

# ---- Private working files (not for public repo) ----
CLAUDE.md
*.docx
*.jpg
*.jpeg
*.png
test.py
