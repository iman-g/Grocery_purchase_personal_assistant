[0m17:27:24.836592 [debug] [Thread-1 (]: On model.grocery.int_price_history: /* {"app": "dbt", "dbt_version": "1.9.10", "profile_name": "grocery", "target_name": "dev", "node_id": "model.grocery.int_price_history"} */

  
  create view "grocery"."main_intermediate"."int_price_history__dbt_tmp" as (
    -- Unified price time series across both stores.
-- One row per (store, product, day) with a common schema, so AH and Lidl prices
-- can be compared and trended side by side. This is the backbone the marts and the
-- ML feature layer read from.

with ah as (

    select
        store,
        product_id,
        product_name_nl,
        price,
        original_price,
        discount_pct,
        is_on_offer,
        scrape_date
    from "grocery"."main_staging"."stg_ah_products"

),

lidl as (

    select
        store,
        -- Lidl has no id; use a stable hash of the NL name as its product_id
        md5(product_name_nl)      as product_id,
        product_name_nl,
        price,
        original_price,
        discount_pct,
        is_on_offer,
        scrape_date
    from "grocery"."main_staging"."stg_lidl_offers"

),

unioned as (
    select * from ah
    union all
    select * from lidl
)

select
    store,
    product_id,
    product_name_nl,
    price,
    original_price,
    -- normalise discount depth: prefer explicit pct, else derive from prices
    coalesce(
        discount_pct,
        case
            when original_price is not null and original_price > 0 and price < original_price
            then round(100.0 * (original_price - price) / original_price, 1)
        end
    )                                                    as discount_pct,
    is_on_offer,
    scrape_date
from unioned
  );

[0m17:27:24.836592 [debug] [Thread-3 (]: SQL status: OK in 0.001 seconds
[0m17:27:24.837585 [debug] [Thread-3 (]: Using duckdb connection "model.grocery.int_product_identity"
[0m17:27:24.837585 [debug] [Thread-3 (]: On model.grocery.int_product_identity: /* {"app": "dbt", "dbt_version": "1.9.10", "profile_name": "grocery", "target_name": "dev", "node_id": "model.grocery.int_product_identity"} */

  
  create view "grocery"."main_intermediate"."int_product_identity__dbt_tmp" as (
    -- One row per distinct product seen in either store, with an English name where
-- available. AH products get their English name from the translation memory (by id);
-- Lidl products already carry title_eng from the scraper.
--
-- Cross-store product matching (linking an AH product to the "same" Lidl product) is
-- deliberately NOT done here with a fuzzy join in SQL — it belongs in the ML/identity
-- step where rapidfuzz can be applied. This model exposes a clean, English-named
-- product dimension per store for that step (and the app) to build on.

with ah_products as (

    select distinct
        store,
        product_id,
        product_name_nl,
        main_category,
        sub_category,
        brand
    from "grocery"."main_staging"."stg_ah_products"

),

ah_named as (

    select
        p.store,
        p.product_id,
        p.product_name_nl,
        coalesce(t.product_name_en, p.product_name_nl) as product_name_en,
        p.main_category,
        p.sub_category,
        p.brand
    from ah_products p
    left join "grocery"."main_staging"."stg_translation_memory" t
        on t.product_id = p.product_id
       and t.store = 'albert_heijn'

),

lidl_products as (

    select distinct
        store,
        md5(product_name_nl)       as product_id,
        product_name_nl,
        -- fall back to the Dutch name when the scraper had no English translation
        -- (same coalesce logic as the AH side above; ~225 Lidl products untranslated)
        coalesce(product_name_en, product_name_nl) as product_name_en,
        cast(null as varchar)      as main_category,
        cast(null as varchar)      as sub_category,
        cast(null as varchar)      as brand
    from "grocery"."main_staging"."stg_lidl_offers"

)

select * from ah_named
union all
select * from lidl_products
  );

